# ─────────────────────────────────────────────────────────────────────────────
# django-mcp configuration
#
# Copy this file to `.env` and edit as needed:
#     cp .env.example .env
#
# Every value here is optional — the server runs with sensible defaults and no
# .env file at all. Nothing here is a secret; this server needs no credentials.
#
# Precedence: CLI flag  >  environment variable  >  default below.
# So `django-mcp --timeout 30000` overrides REQUEST_TIMEOUT_MS.
#
# When launched by an MCP client, prefer the client's own `env` block — it is
# applied before this file and always wins.
# ─────────────────────────────────────────────────────────────────────────────


# ─── Documentation source ────────────────────────────────────────────────────

# Which Django docs version to serve. Accepts any version published at
# docs.djangoproject.com/en/<version>/ — for example 6.0, 5.2, 4.2, stable or dev.
# Set this to match the Django version your project actually runs.
# Flag: --docs-version
DJANGO_DOCS_VERSION=6.0


# ─── Network ─────────────────────────────────────────────────────────────────

# Per-request timeout in milliseconds. Raise it on a slow or filtered network.
# Flag: --timeout
REQUEST_TIMEOUT_MS=15000

# Retry attempts for transient failures (429, 500, 502, 503, 504, timeouts).
# Retries use exponential backoff and honour any Retry-After header.
# Flag: --retries
REQUEST_RETRIES=2


# ─── Caching ─────────────────────────────────────────────────────────────────
# Documents are cached in memory only, for the lifetime of the process.
# Nothing is written to disk.

# Maximum cached documents before the least recently used one is evicted.
# Flag: --cache-max
CACHE_MAX_ENTRIES=100

# How long a fetched page stays fresh, in milliseconds. Default 3 hours.
# Flag: --doc-ttl
DOC_TTL_MS=10800000

# How long the Sphinx object inventory stays fresh. Default 24 hours — it is a
# single ~110 KB download that changes only when Django publishes a release.
# Flag: --index-ttl
INDEX_TTL_MS=86400000

# How long a *failed* fetch is remembered before it is retried. Default 1 minute.
# Flag: --negative-ttl
NEGATIVE_TTL_MS=60000


# ─── Search ──────────────────────────────────────────────────────────────────

# Default number of results from search_django_docs when the caller does not
# pass maxResults. The inventory holds ~8,000 symbols, so a slightly larger
# default than the sibling servers is useful here.
# Flag: --max-results
SEARCH_MAX_RESULTS=10
