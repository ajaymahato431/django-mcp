# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.yarn/

# ─── Environment & secrets ───────────────────────────────────────────────────
# Never commit real configuration. The template below is the only exception.
.env
.env.*
!.env.example

# npm auth token. `npm config set ... --location=project` writes it here in
# plaintext; ignoring the file means a slip never becomes a committed secret.
.npmrc

# ─── Python virtual environments (for contributors with mixed toolchains) ────
.venv/
venv/
env/
__pycache__/
*.py[cod]

# ─── Build output & caches ───────────────────────────────────────────────────
dist/
build/
out/
coverage/
*.tsbuildinfo
.cache/
.temp/
.tmp/

# ─── Logs & diagnostics ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.node_repl_history

# ─── Packaged artifacts ──────────────────────────────────────────────────────
*.tgz
*.zip
*.tar.gz

# ─── Editor & OS noise ───────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
